rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User progress and profile documents
    // Publicly readable so peers/recruiters can verify public portfolios
    // Only the authenticated owner can write to their own progress
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Project submissions and proofs
    // Publicly readable for portfolio showcase verification
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Official accredited certificates collection for instant verification
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
